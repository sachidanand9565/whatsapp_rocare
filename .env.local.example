# ============================================================
# WhatsApp SaaS — Environment Variables
# Copy this file to .env.local and fill in your values
# ============================================================

# ---- Database (MySQL) ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=whatsapp_saas

# ---- Auth ----
JWT_SECRET=change-this-to-a-long-random-string-in-production
JWT_EXPIRES=7d

# ---- Redis (BullMQ flow/chatbot queue workers — see lib/queue.ts, workers/*.ts) ----
# Defaults assume Redis running locally on the same box as the app.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- Meta WhatsApp Cloud API ----
# These are workspace-level settings stored in DB.
# You can also set default values here for single-tenant use.
WHATSAPP_ACCESS_TOKEN=EAARR3vmzVEwBRPinCENmQH99ftxZB4LaNhhiyNtlXZA1SQ7ZCGAanRP9kPIVOjFUOCzMZBqCzZAEBUSsAHZAvz6MKRqaz0Hj1ZAKZBbwFtVy9JzIN2uGh6shEsRVbtTcHgB8WzSkFB9wk9MHVKZCT9gDcd1vb9XKirACsagjLeJxypuZAvlE1CrZAWwCB8qfQR5ZC9N4wiZB91PGkwJwhMf6OS3qqgMb7TUUJGdd3lRWZAonRIfo9kTdgAvDrQPpkZA8tSZAvicIc7rmHBGVogjVzES9dq7ntsRR
PHONE_NUMBER_ID=930245630177351
WABA_ID=1736454720919400
VERIFY_TOKEN=sachi9565

# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ---- CORS ---- (comma-separated origins allowed to call /api/* cross-origin)
CORS_ALLOWED_ORIGIN=https://limbu.ai,http://localhost:3000

# ---- SSO ---- (server-to-server secret for /api/auth/sso-login from limbu.ai backend)
# Strong random value, e.g. `openssl rand -hex 32`
SSO_SHARED_SECRET=change-me-strong-random-secret

# ---- Super Admin ---- (comma-separated emails for platform super-admin access)
SUPER_ADMIN_EMAILS=owner@example.com
